rules_version = '2';

// =====================================================================
// MyGoatFarms — Firestore Security Rules
//
// Access model:
//   1. Farm owner:   farms/{farmId}.authUid == request.auth.uid
//   2. Farm partner: farms/{farmId}/partners/{uid} exists AND `status`
//      is 'active' (or absent, for docs written before the approval
//      workflow existed).
//   3. Admin:        a signed-in user with a /admins/{uid} document
//      (created only from the Firebase Console).
//
// ---------------------------------------------------------------------
// SECURITY HARDENING (this version) — what changed and why
// ---------------------------------------------------------------------
//   A. MOBILE LOGIN LOOKUP no longer needs public queries.
//      The app now resolves "mobile number -> email" through the
//      `resolveLoginEmail` Cloud Function and checks "number already
//      registered" through `isMobileRegistered`. The old public
//      `list` rules let anyone page through EVERY farm and partner
//      document one at a time (limit(1) + a range filter + a cursor).
//      Those rules are kept ONLY inside the clearly marked
//      "TRANSITION" blocks below so users still on the old app version
//      can log in. DELETE the TRANSITION blocks once every user has the
//      new app version (see the checklist at the end of this file).
//
//   B. SUBSCRIPTION CAN NO LONGER BE SELF-APPROVED.
//      Owners could write `subscriptionInfo` (and the older top-level
//      `status` / `rejection`) on their own farm doc and mark it
//      Active. Only the admin can set those now. Owners also can no
//      longer change `authUid`, `mobileNumber`, `email` or `createdAt`
//      on the farm doc — the app never does, and changing them would
//      break login and the mobile-number index.
//
//   C. TRADING PARTNER PERMISSIONS ARE ENFORCED HERE, not only in the
//      app. A partner can WRITE trading data (lots, sales, customers,
//      counters, dashboard summary) only if the owner gave them at
//      least one Trading or Finance write permission. Reading is
//      unchanged. This is deliberately "any trading/finance write
//      permission", not one permission per collection: one sale or
//      purchase touches several collections at once, so a finer split
//      would make normal saves fail half-way for permitted partners.
//
//   D. NO DELETES OF FINANCIAL HISTORY.
//      Lots (and their payments / receivings / deaths), trading goats,
//      sale customers, archived sales, expenses, the trading summary,
//      the number counters and the activity log can no longer be
//      deleted by anyone through the app (the app never deletes them —
//      it voids or cancels instead). A sale can only be deleted in the
//      same save that archives it to archivedSales (which is exactly
//      what "Delete sale" does), so a deleted sale always leaves a copy.
//      The admin website and Cloud Functions can still delete.
//
//   E. ACTIVITY LOG IS APPEND-ONLY. Entries can be created but never
//      edited or removed from the app, so it stays a trustworthy audit
//      trail.
//
//   F. NUMBER COUNTERS ONLY GO UP. tradingCounters (PUR / SALE / goat
//      numbers) can never be lowered, so a reset can never make a new
//      sale overwrite an existing SALE-xxxx.
//
//   G. TYPE CHECKS ON TRADING NUMBERS. Lot quantities and money, lot
//      payment amounts and dashboard counters must stay numbers. Only
//      the fields a write actually CHANGES are checked, so old records
//      with odd legacy values never block a normal save. Values are not
//      range-checked (same reason as Palai balances below).
//
//   H. ADMIN WEBSITE WRITES ARE VALIDATED. subscriptionInfo written by
//      the admin, enquiries, plans and the support contact (name,
//      mobile, up to 5 more phones and 1–5 emails) are shape-checked.
//      Admin website only — no app rule changed.
//
// Everything else (Palai, stock, bills, finance transactions,
// mobileIndex create, counters/farms) is unchanged.
// =====================================================================

service cloud.firestore {

  match /databases/{database}/documents {

    // ================================================================
    // AUTHENTICATION HELPERS
    // ================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(farmId) {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/farms/$(farmId)
        ).data.authUid == request.auth.uid;
    }

    function partnerPath(farmId) {
      return /databases/$(database)/documents/farms/$(farmId)/partners/$(request.auth.uid);
    }

    function isPartner(farmId) {
      // Only an 'active' partner gets farm access. Docs written before
      // the approval workflow have no 'status' and default to 'active'.
      return isSignedIn()
        && exists(partnerPath(farmId))
        && get(partnerPath(farmId)).data.get('status', 'active') == 'active';
    }

    function isOwnerOrPartner(farmId) {
      return isOwner(farmId) || isPartner(farmId);
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- C. Trading permissions ----------------------------------------
    // Keys are the ones PartnerPermissions.toMap() writes on the partner
    // doc (`permissions` map). A missing key counts as "not allowed",
    // exactly like the app (PartnerPermissions.fromMap).
    function hasTradingWritePermission(p) {
      return p.get('tradingPurchaseCreate', false) == true
        || p.get('tradingSell', false) == true
        || p.get('tradingSupplierPayment', false) == true
        || p.get('tradingReceive', false) == true
        || p.get('tradingManageStock', false) == true
        || p.get('financeRevenueCreate', false) == true
        || p.get('financeRevenueEdit', false) == true
        || p.get('financeRevenueVoid', false) == true
        || p.get('financeExpenseCreate', false) == true
        || p.get('financeExpenseEdit', false) == true
        || p.get('financeExpenseVoid', false) == true;
    }

    // Owner always; a partner only with a Trading / Finance write
    // permission. Re-reads the same partner doc isPartner() already
    // read, so it does not add a new document read.
    function canWriteTrading(farmId) {
      return isOwner(farmId)
        || (isPartner(farmId)
            && hasTradingWritePermission(
              get(partnerPath(farmId)).data.get('permissions', {})
            ));
    }

    // --- G. Type checks --------------------------------------------------
    // The keys this write adds, changes or removes. On create, every key.
    function changedKeys() {
      return resource == null
        ? request.resource.data.keys().toSet()
        : request.resource.data.diff(resource.data).affectedKeys();
    }

    // True when [k] is untouched, removed, or written as a number.
    function numberIfChanged(ch, k) {
      return !(k in ch) || request.resource.data.get(k, 0) is number;
    }

    function lotNumbersValid() {
      let ch = changedKeys();
      return numberIfChanged(ch, 'totalGoats')
        && numberIfChanged(ch, 'maleGoats')
        && numberIfChanged(ch, 'femaleGoats')
        && numberIfChanged(ch, 'totalWeightAtPurchase')
        && numberIfChanged(ch, 'pricePerKg')
        && numberIfChanged(ch, 'purchaseAmount')
        && numberIfChanged(ch, 'fixedPurchaseAmount')
        && numberIfChanged(ch, 'paidAmount')
        && numberIfChanged(ch, 'grandTotal')
        && numberIfChanged(ch, 'transportCost')
        && numberIfChanged(ch, 'loadingCharges')
        && numberIfChanged(ch, 'unloadingCharges')
        && numberIfChanged(ch, 'otherExpenses')
        && numberIfChanged(ch, 'receivedAliveQty')
        && numberIfChanged(ch, 'mortality')
        && numberIfChanged(ch, 'farmDeathQty')
        && numberIfChanged(ch, 'soldFromSupplierQty')
        && numberIfChanged(ch, 'soldFromFarmQty')
        && numberIfChanged(ch, 'reservedFarmQty')
        && numberIfChanged(ch, 'reservedSupplierQty')
        && numberIfChanged(ch, 'registeredCount')
        && numberIfChanged(ch, 'pendingCount');
    }

    function summaryNumbersValid() {
      let ch = changedKeys();
      return numberIfChanged(ch, 'wholesalePurchased')
        && numberIfChanged(ch, 'totalStock')
        && numberIfChanged(ch, 'pendingRegistrations')
        && numberIfChanged(ch, 'totalSold')
        && numberIfChanged(ch, 'booking')
        && numberIfChanged(ch, 'waitOnDelivery')
        && numberIfChanged(ch, 'totalProfit');
    }

    // Palai customer balances must stay numbers (unchanged).
    function customerBalancesAreNumbers() {
      let d = request.resource.data;
      return d.get('pendingAmount', 0) is number
        && d.get('advanceAmount', 0) is number
        && d.get('billPaymentCredit', 0) is number;
    }

    // --- B. Farm document fields only the admin may set ------------------
    function adminOnlyFarmFields() {
      return ['subscriptionInfo', 'status', 'rejection', 'blocked'];
    }

    // Fields fixed once the farm exists (login + mobile index rely on them).
    function lockedFarmFields() {
      return ['authUid', 'mobileNumber', 'email', 'createdAt'];
    }

    // --- ADMIN WEBSITE: shape of subscriptionInfo the admin panel writes --
    function isValidSubscriptionInfo(info) {
      return info is map
        && info.get('status', 'Pending') in ['Pending', 'Active', 'Rejected']
        && (!('expiryDate' in info) || info.expiryDate is number)
        && (!('durationDays' in info) || (info.durationDays is int && info.durationDays >= 1 && info.durationDays <= 3650))
        && (!('amount' in info) || (info.amount is number && info.amount >= 0 && info.amount <= 1000000))
        && (!('blocked' in info) || (info.blocked is map && info.blocked.get('blocked', false) is bool));
    }


    // ================================================================
    // FARMS
    // ================================================================

    match /farms/{farmId} {

      allow get: if isOwnerOrPartner(farmId) || isAdmin();

      // Post-login lookup of the signed-in owner's own farm
      // (getFarmByAuthUid). The admin can list every farm.
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.authUid == request.auth.uid);

      // ---------------------------------------------------------------
      // TRANSITION — remove after every user has the new app version.
      // Old app versions look up "mobile -> email" with a public query.
      // This rule can be abused to page through every farm document.
      // ---------------------------------------------------------------
      allow list:
        if request.query.limit <= 1
        && resource.data.mobileNumber is string;
      // --------------------------- END TRANSITION ---------------------

      // B. A new farm can never start with an approved subscription.
      allow create:
        if isSignedIn()
        && request.resource.data.authUid == request.auth.uid
        && !request.resource.data.keys().hasAny(adminOnlyFarmFields());

      // B. Owner edits everything except subscription/approval fields and
      //    the login identity fields. Admin edits subscriptionInfo only.
      allow update:
        if (isOwner(farmId)
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(adminOnlyFarmFields().concat(lockedFarmFields())))
        || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['subscriptionInfo'])
            && isValidSubscriptionInfo(request.resource.data.subscriptionInfo));

      allow delete:
        if isOwner(farmId) || isAdmin();


      // ============================================================
      // STOCK
      // ============================================================

      match /stockItems/{itemId} {
        allow read, write: if isOwnerOrPartner(farmId);
      }

      match /stockMovements/{movementId} {
        allow read, write: if isOwnerOrPartner(farmId);
      }


      // ============================================================
      // ACTIVITIES — E. append-only audit log
      // ============================================================

      match /activities/{activityId} {
        allow read, create: if isOwnerOrPartner(farmId);
        allow update, delete: if false;
      }


      // ============================================================
      // TRANSACTIONS (income / expenses / Palai payments)
      //
      // Delete stays allowed: completing a booking replaces its
      // booking-day revenue row, and deleting a Palai bill removes its
      // advance-use rows.
      // ============================================================

      match /transactions/{transactionId} {
        allow read, write: if isOwnerOrPartner(farmId);
      }


      // ============================================================
      // EXPENSES — D. never deleted (the app voids them)
      // ============================================================

      match /expenses/{expenseId} {
        allow read, create, update: if isOwnerOrPartner(farmId);
        allow delete: if false;
      }


      // ============================================================
      // PAYMENTS (customer / Palai billing)
      // ============================================================

      match /payments/{paymentId} {
        allow read, write: if isOwnerOrPartner(farmId);
      }


      // ============================================================
      // NOTIFICATIONS — only the owner deletes
      // ============================================================

      match /notifications/{notificationId} {
        allow read: if isOwnerOrPartner(farmId);
        allow create, update: if isOwnerOrPartner(farmId);
        allow delete: if isOwner(farmId);
      }


      // ============================================================
      // BILLS / MONTHLY BILLS / BILLING + PAYMENT RECORDS
      // ============================================================

      match /bills/{billId} {
        allow read, write: if isOwnerOrPartner(farmId);
      }

      match /monthlyBills/{billId} {
        allow read, write: if isOwnerOrPartner(farmId);
      }

      match /billingRecords/{billingRecordId} {
        allow read, write: if isOwnerOrPartner(farmId);
      }

      match /paymentRecords/{paymentId} {
        allow read, write: if isOwnerOrPartner(farmId);
      }


      // ============================================================
      // PALAI CUSTOMERS (unchanged)
      // ============================================================

      match /palaiCustomers/{customerId} {

        allow read: if isOwnerOrPartner(farmId) || isAdmin();

        allow create, update:
          if isOwnerOrPartner(farmId) && customerBalancesAreNumbers();

        allow delete: if isOwnerOrPartner(farmId);

        match /advanceEntries/{entryId} {
          allow read: if isOwnerOrPartner(farmId) || isAdmin();
          allow create, update:
            if isOwnerOrPartner(farmId)
            && request.resource.data.get('amount', 0) is number;
          allow delete: if isOwnerOrPartner(farmId);
        }

        match /goats/{goatId} {
          allow read: if isOwnerOrPartner(farmId) || isAdmin();
          allow write: if isOwnerOrPartner(farmId);

          match /palaiWeightRecords/{recordId} {
            allow read, write: if isOwnerOrPartner(farmId);
          }
          match /healthRecords/{recordId} {
            allow read, write: if isOwnerOrPartner(farmId);
          }
          match /healthEvents/{eventId} {
            allow read, write: if isOwnerOrPartner(farmId);
          }
          match /monthlyPhotos/{photoId} {
            allow read, write: if isOwnerOrPartner(farmId);
          }
          match /reports/{reportId} {
            allow read, write: if isOwnerOrPartner(farmId);
          }
          match /weightRecords/{recordId} {
            allow read, write: if isOwnerOrPartner(farmId);
          }
          match /vaccinationRecords/{recordId} {
            allow read, write: if isOwnerOrPartner(farmId);
          }
          match /medicineRecords/{recordId} {
            allow read, write: if isOwnerOrPartner(farmId);
          }
          match /hoofCuttingRecords/{recordId} {
            allow read, write: if isOwnerOrPartner(farmId);
          }
          match /hairTrimmingRecords/{recordId} {
            allow read, write: if isOwnerOrPartner(farmId);
          }
        }
      }


      // ============================================================
      // PARTNERS — owner manages; partner reads own settings
      // ============================================================

      match /partners/{partnerId} {

        allow read: if isOwnerOrPartner(farmId) || isAdmin();

        allow create, update, delete: if isOwner(farmId);

        match /settings/{docId} {
          allow read:
            if isOwner(farmId)
            || (isSignedIn() && request.auth.uid == partnerId);
          allow write: if isOwner(farmId);
        }
      }


      // ============================================================
      // OWN FARM GOATS / EXPENSES (unchanged)
      // ============================================================

      match /ownFarmGoats/{goatId} {
        allow read, write: if isOwnerOrPartner(farmId);

        match /growthRecords/{recordId} {
          allow read, write: if isOwnerOrPartner(farmId);
        }
        match /healthEvents/{eventId} {
          allow read, write: if isOwnerOrPartner(farmId);
        }
        match /breedingRecords/{recordId} {
          allow read, write: if isOwnerOrPartner(farmId);
        }
      }

      match /ownFarmExpenses/{expenseId} {
        allow read, write: if isOwnerOrPartner(farmId);
      }


      // ============================================================
      // TRADING GOATS (registered + Own Palai goats)
      //
      // Writes stay open to any owner/partner: Own Palai weigh-ins,
      // health records and death settlement run outside the Trading
      // permission gates in the app. D. The goat document itself is
      // never deleted by the app (status changes instead).
      // ============================================================

      match /tradingGoats/{goatId} {

        allow read: if isOwnerOrPartner(farmId) || isAdmin();
        allow create, update: if isOwnerOrPartner(farmId);
        allow delete: if false;

        match /weightHistory/{recordId} {
          allow read, write: if isOwnerOrPartner(farmId);
        }

        match /healthRecords/{recordId} {
          allow read, write: if isOwnerOrPartner(farmId);
        }
      }


      // ============================================================
      // TRADING PURCHASES (lots) — C, D, G
      // ============================================================

      match /tradingPurchases/{lotId} {

        allow read: if isOwnerOrPartner(farmId);
        allow create, update:
          if canWriteTrading(farmId) && lotNumbersValid();
        allow delete: if false;

        match /payments/{paymentId} {
          allow read: if isOwnerOrPartner(farmId);
          allow create, update:
            if canWriteTrading(farmId)
            && request.resource.data.get('amount', 0) is number;
          allow delete: if false;
        }

        match /receivings/{receivingId} {
          allow read: if isOwnerOrPartner(farmId);
          allow create, update: if canWriteTrading(farmId);
          allow delete: if false;
        }

        match /deaths/{deathId} {
          allow read: if isOwnerOrPartner(farmId);
          allow create, update: if canWriteTrading(farmId);
          allow delete: if false;
        }
      }


      // ============================================================
      // SALES — C; D. deleted only together with its archive copy
      // ============================================================

      match /sales/{saleId} {
        allow read: if isOwnerOrPartner(farmId);
        allow create, update: if canWriteTrading(farmId);
        allow delete:
          if canWriteTrading(farmId)
          && existsAfter(
            /databases/$(database)/documents/farms/$(farmId)/archivedSales/$(saleId)
          );
      }

      match /archivedSales/{saleId} {
        allow read: if isOwnerOrPartner(farmId);
        allow create, update: if canWriteTrading(farmId);
        allow delete: if false;
      }


      // ============================================================
      // SALE CUSTOMERS (Sell Goat / Sell From Lot buyers) — C, D
      // ============================================================

      match /customers/{customerId} {
        allow read: if isOwnerOrPartner(farmId);
        allow create, update: if canWriteTrading(farmId);
        allow delete: if false;
      }


      // ============================================================
      // TRADING DASHBOARD SUMMARY — C, D, G
      // ============================================================

      match /tradingSummary/{docId} {
        allow read: if isOwnerOrPartner(farmId);
        allow create, update:
          if canWriteTrading(farmId) && summaryNumbersValid();
        allow delete: if false;
      }


      // ============================================================
      // TRADING NUMBER COUNTERS — C, D, F
      // purchaseCounter / saleCounter / goatCounter: { lastValue }
      // ============================================================

      match /tradingCounters/{counterId} {
        allow read: if isOwnerOrPartner(farmId);

        allow create:
          if canWriteTrading(farmId)
          && request.resource.data.get('lastValue', 0) is int
          && request.resource.data.get('lastValue', 0) >= 0;

        allow update:
          if canWriteTrading(farmId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastValue'])
          && request.resource.data.get('lastValue', 0) is int
          && request.resource.data.get('lastValue', 0)
              >= resource.data.get('lastValue', 0);

        allow delete: if false;
      }


      // ============================================================
      // DEATH RECORDS (unchanged)
      // ============================================================

      match /deathRecords/{lossId} {
        allow read, write: if isOwnerOrPartner(farmId);

        match /proofs/{proofId} {
          allow read, write: if isOwnerOrPartner(farmId);
        }
      }


      // ============================================================
      // CATCH-ALL FOR OTHER FIRST-LEVEL FARM SUB-COLLECTIONS
      //
      // Firestore ORs every matching rule, so any collection with its
      // own stricter block above MUST be listed here — otherwise this
      // catch-all would silently re-allow what that block forbids.
      // ============================================================

      match /{subCollection}/{documentId} {
        allow read, write:
          if isOwnerOrPartner(farmId)
          && !(subCollection in [
            'partners',
            'notifications',
            'palaiCustomers',
            'activities',
            'expenses',
            'tradingGoats',
            'tradingPurchases',
            'sales',
            'archivedSales',
            'customers',
            'tradingSummary',
            'tradingCounters'
          ]);
      }
    }


    // =================================================================
    // ADMIN — farm deletion from the admin website (read + delete only)
    // =================================================================

    match /farms/{farmId}/{document=**} {
      allow read, delete: if isAdmin();
    }


    // =================================================================
    // COLLECTION-GROUP GOATS (unchanged)
    // =================================================================

    match /{path=**}/goats/{goatId} {
      allow read:
        if isOwnerOrPartner(resource.data.farmId)
        || isOwnerOrPartner(path[1]);
    }


    // =================================================================
    // COLLECTION-GROUP PARTNERS
    // A signed-in user can read only their own partner doc.
    // =================================================================

    match /{path=**}/partners/{partnerId} {

      allow get, list:
        if isSignedIn() && resource.data.authUid == request.auth.uid;

      // ---------------------------------------------------------------
      // TRANSITION — remove after every user has the new app version.
      // Old app versions look up partners by mobile number before
      // sign-in. This rule can be abused to page through every partner.
      // ---------------------------------------------------------------
      allow list:
        if request.query.limit <= 1
        && resource.data.mobileNumber is string;
      // --------------------------- END TRANSITION ---------------------
    }


    // =================================================================
    // MOBILE NUMBER INDEX
    //   mobileIndex/{mobileNumber} -> { farmId, authUid, createdAt }
    //
    // The new app checks "already registered" before sign-up through
    // the `isMobileRegistered` Cloud Function, and only reads this doc
    // directly when signed in (createFarm, Add Partner).
    // =================================================================

    match /mobileIndex/{mobileNumber} {

      allow get: if isSignedIn();

      // ---------------------------------------------------------------
      // TRANSITION — remove after every user has the new app version.
      // Old app versions read this before sign-up (not signed in).
      // ---------------------------------------------------------------
      allow get: if true;
      // --------------------------- END TRANSITION ---------------------

      allow list: if false;

      allow create:
        if isSignedIn()
        && request.resource.data.keys().hasOnly(['farmId', 'authUid', 'createdAt'])
        && request.resource.data.farmId is string
        && request.resource.data.authUid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/farms/$(request.resource.data.farmId)
        ).data.authUid == request.auth.uid;

      allow update, delete: if false;
    }


    // =================================================================
    // FARM COUNTER (unchanged)
    // =================================================================

    match /counters/farms {
      allow read: if isSignedIn();

      allow create:
        if isSignedIn()
        && request.resource.data.keys().hasOnly(['lastId'])
        && request.resource.data.lastId is int;

      allow update:
        if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastId'])
        && request.resource.data.lastId == resource.data.lastId + 1;

      allow delete: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }


    // =================================================================
    // ADMIN WEBSITE COLLECTIONS
    // Validated so a bad write from the website (or anyone calling the
    // API directly) can't break the admin panel or rewrite history.
    // =================================================================

    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Payment history: fixed shape on create, only the status can change
    // later (e.g. Pending -> Paid), never deleted.
    match /subscriptionPayments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['farmId', 'farmName', 'amount', 'plan', 'durationDays', 'date', 'status', 'reference', 'type', 'createdAt', 'recordedBy'])
        && request.resource.data.farmId is string && request.resource.data.farmId.size() > 0
        && request.resource.data.amount is number && request.resource.data.amount >= 0 && request.resource.data.amount <= 1000000
        && request.resource.data.durationDays is int && request.resource.data.durationDays >= 1 && request.resource.data.durationDays <= 3650
        && request.resource.data.status in ['Paid', 'Pending', 'Failed', 'Refunded']
        && request.resource.data.type in ['new', 'renewal']
        && request.resource.data.plan is string && request.resource.data.plan.size() <= 40
        && request.resource.data.reference is string && request.resource.data.reference.size() <= 120;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt'])
        && request.resource.data.status in ['Paid', 'Pending', 'Failed', 'Refunded'];
      allow delete: if false;
    }

    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'status', 'receivedAt'])
        && request.resource.data.status == 'New'
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 254
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.receivedAt is string
        && request.resource.data.receivedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$');
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['New', 'Read'];
    }

    match /adminSettings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && (docId != 'subscriptionPlans'
            || (request.resource.data.plans is list
                && request.resource.data.plans.size() >= 1
                && request.resource.data.plans.size() <= 20));
    }

    match /config/{docId} {
      allow get: if isSignedIn();
      allow list: if false;
      // The app only reads config/adminContact (approval screen); the
      // admin website writes it. `phone` / `email` mirror the main mobile
      // and first email for app versions that only read those two keys.
      allow create, update: if isAdmin()
        && (docId != 'adminContact'
            || (request.resource.data.keys().hasOnly(['name', 'mobile', 'phones', 'emails', 'phone', 'email', 'updatedAt'])
                && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
                && request.resource.data.mobile is string && request.resource.data.mobile.size() > 0 && request.resource.data.mobile.size() <= 20
                && request.resource.data.phones is list && request.resource.data.phones.size() <= 5
                && request.resource.data.emails is list && request.resource.data.emails.size() >= 1 && request.resource.data.emails.size() <= 5
                && request.resource.data.email is string
                && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                && request.resource.data.phone is string && request.resource.data.phone.size() <= 20));
      allow delete: if false;
    }


    // =================================================================
    // DEFAULT DENY
    // =================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// =====================================================================
// AFTER EVERY USER HAS UPDATED THE APP — remove the 3 TRANSITION blocks:
//   1. farms/{farmId}            `allow list: if request.query.limit <= 1 ...`
//   2. {path=**}/partners/{id}   `allow list: if request.query.limit <= 1 ...`
//   3. mobileIndex/{mobile}      `allow get: if true;`
// Then deploy again. Until then the public-lookup hole (A) stays open
// for old app versions.
// =====================================================================
